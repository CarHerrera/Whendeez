filters:
  and:
    - file.inFolder("Mirage/Execs")
views:
  - type: cards
    name: All execs
    filterBy:
      property: Lands
    order:
      - file.name
      - Creator
      - image
      - Date Added
      - Link
      - Nickname
    image: note.image
  - type: table
    name: View
    filterBy:
      property: Lands

views:
  - type: cards
    name: Table
    filters:
      and:
        - "!Nade.isEmpty()"
        - Map.contains("Mirage")
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - Link
      - Nade
      - Side
    sort:
      - property: image
        direction: ASC
    image: note.image

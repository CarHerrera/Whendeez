filters:
  and:
    - "!Nade.isEmpty()"
    - Map == "Mirage"
views:
  - type: cards
    name: All nades
    filters:
      and:
        - Side == "T"
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - Link
      - Nade
      - Side
      - From
      - Usage
      - Creator
      - Used by
    sort:
      - property: file.name
        direction: ASC
      - property: Creator
        direction: ASC
      - property: Used by
        direction: ASC
    image: note.image
    imageFit: contain
  - type: cards
    name: Smoke
    filters:
      and:
        - Nade == ["Smoke"]
    groupBy:
      property: Usage
      direction: ASC
    order:
      - file.name
      - Usage
      - Side
      - Creator
    sort:
      - property: Side
        direction: ASC
    image: note.image
  - type: cards
    name: Flashes
    filters:
      and:
        - Nade.containsAny("Flash", "Flashbang")
    groupBy:
      property: Usage
      direction: ASC
    order:
      - file.name
      - Have Tried
      - From
      - Link
      - Side
      - Usage
    cardSize: 300
    image: note.image
  - type: cards
    name: Fire
    filters:
      and:
        - Nade.containsAny("Molotov")
    order:
      - file.name
      - Creator
      - Date Added
      - Have Tried
      - From
      - Side
      - Usage
    image: note.image
    cardSize: 300
  - type: cards
    name: View
    filters:
      and:
        - note["Used by"].contains("Carlos")
        - Side == "CT"
    groupBy:
      property: Nade
      direction: ASC
    image: note.image
  - type: table
    name: View 2
    order:
      - file.name
      - Lands
      - Side
      - Used by
      - Nade
    sort: []
    columnSize:
      note.Lands: 221

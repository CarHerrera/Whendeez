filters:
  and:
    - file.inFolder("Mirage/Nades")
views:
  - type: cards
    name: Table
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - Link
      - Nade
      - Side
      - From
      - Usage
      - Creator
    sort:
      - property: file.name
        direction: ASC
      - property: Creator
        direction: ASC
    image: note.image

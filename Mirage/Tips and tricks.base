filters:
  and:
    - file.inFolder("Mirage/Tips & Tricks")
views:
  - type: cards
    name: All tips
    filterBy:
      property: Lands
    groupBy:
      property: Type
      direction: ASC
    order:
      - file.name
      - Date Added
      - Creator
      - From
      - Have Tried
      - Link
      - Side
      - Type
    image: note.image

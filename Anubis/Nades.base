filters:
  or:
    - file.inFolder("Anubis/Nades")
    - and:
        - file.inFolder("Anubis/Tips & Tricks")
        - Type == "Util"
views:
  - type: cards
    name: Table
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - Nade
      - Side
    sort:
      - property: image
        direction: ASC
    cardSize: 260
    image: note.image
  - type: table
    name: Table 2
    filters:
      and:
        - Map.contains("Anubis")
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - Nade
      - Side
      - Map
    sort:
      - property: image
        direction: ASC
    cardSize: 260
    image: note.image

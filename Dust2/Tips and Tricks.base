filters:
  and:
    - file.inFolder("Dust2/Tips & Tricks")
views:
  - type: cards
    name: Table
    filterBy:
      property: Lands
    order:
      - file.name
      - Date Added
      - Creator
      - From
      - Link
      - Side
      - Type
      - file.backlinks
    image: note.image
    cardSize: 310
    imageAspectRatio: 1
    imageFit: contain

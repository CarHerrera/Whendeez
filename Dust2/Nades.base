filters:
  or:
    - file.inFolder("Dust2/Dust 2 Nades")
    - and:
        - file.hasProperty("Nade")
        - Map.containsAny(link("../Dust2", "Dust2"), "Dust2")
formulas:
  Untitled: ""
views:
  - type: cards
    name: All nades
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - From
      - Have Tried
      - image
      - Link
      - Map
      - Nade
      - Side
      - Creator
      - Date Added
      - Usage
      - Used by
    sort:
      - property: Usage
        direction: ASC
      - property: Side
        direction: ASC
      - property: Creator
        direction: ASC
    image: note.image
    imageAspectRatio: 1.1
    cardSize: 300
    imageFit: contain
  - type: table
    name: View
    order:
      - Creator
      - Have Tried
      - Map
      - Nade
      - Used by
      - Side
      - file.name
    sort:
      - property: Used by
        direction: ASC
  - type: cards
    name: Smokes
    filters:
      and:
        - Nade.contains("Smoke")
    order:
      - file.name
      - Used by
      - Side
    image: note.image
    imageAspectRatio: 0.95
    cardSize: 310
  - type: cards
    name: Flashes
    filters:
      and:
        - Nade.containsAny("Flash", "Flashbang")
    order:
      - file.name
      - Used by
    image: note.image
    cardSize: 280
  - type: cards
    name: Flame
    filters:
      and:
        - Nade.containsAny("Molotov")
    order:
      - file.name
      - Creator
      - Date Added
      - From
      - Link
      - Map
      - Nade
      - Side
      - Usage
      - Used by
    cardSize: 300
    image: note.image
    imageFit: contain
  - type: table
    name: Grenades
    filters:
      and:
        - Nade.containsAny("Grenade", "HE")

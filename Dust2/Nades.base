filters:
  or:
    - file.inFolder("Dust2/Dust 2 Nades")
    - and:
        - file.hasProperty("Nade")
        - Map == link("../Dust2", "Dust2")
formulas:
  Untitled: ""
views:
  - type: cards
    name: Card View
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - From
      - Have Tried
      - image
      - Link
      - Map
      - Nade
      - Side
      - Creator
      - Date Added
      - file.backlinks
      - formula.Untitled
    sort:
      - property: Side
        direction: ASC
      - property: Creator
        direction: ASC
    image: note.image
    imageAspectRatio: 1.1
    cardSize: 300
  - type: table
    name: View
    order:
      - file.name
      - Date Added
      - Creator
      - From
      - Have Tried
      - Link
      - Map
      - Nade
      - image

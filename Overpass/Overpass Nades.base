views:
  - type: cards
    name: Table
    filters:
      and:
        - Map.contains("Overpass")
        - file.hasProperty("Nade")
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - Link
      - Nade
      - Side
    sort:
      - property: image
        direction: ASC
    image: note.image
  - type: table
    name: View
    filters:
      and:
        - "!Nade.isEmpty()"
        - Map == link("../Overpass")
    order:
      - file.name
      - Map
      - Nade
      - Side
    rowHeight: medium

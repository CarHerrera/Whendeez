views:
  - type: cards
    name: Table
    filters:
      and:
        - Map == "Overpass"
        - file.hasProperty("Nade")
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - Link
      - Nade
      - Side
    sort:
      - property: image
        direction: ASC
    image: note.image

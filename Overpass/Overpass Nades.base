filters:
  and:
    - file.inFolder("Overpass/Nades")
views:
  - type: cards
    name: Table
    filterBy:
      property: Lands
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - Link
      - Nade
      - Side
    sort:
      - property: image
        direction: ASC
    image: note.image
  - type: table
    name: View
    filters:
      and:
        - "!Nade.isEmpty()"
        - Map == link("../Overpass")
    filterBy:
      property: Lands
    order:
      - file.name
      - Map
      - Nade
      - Side
    rowHeight: medium

filters:
  and:
    - Map == "Inferno"
    - '!file.inFolder("Inferno/Execs")'
formulas:
  Untitled: ""
views:
  - type: table
    name: Table
    order:
      - file.name
      - Link
      - Map
      - Nade
      - Side
    sort:
      - property: Nade
        direction: ASC
  - type: table
    name: View
    order:
      - file.name
      - Nade
      - Link
      - file.links
    rowHeight: extra

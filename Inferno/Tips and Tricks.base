filters:
  and:
    - file.inFolder("Inferno/Tips & Tricks")
views:
  - type: cards
    name: Cards All
    filterBy:
      property: Lands
    image: note.image
  - type: table
    name: View
    filterBy:
      property: Lands
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - Date Added
      - From
      - Have Tried
      - Link
      - Map
      - Nade
      - Side
    sort:
      - property: Side
        direction: ASC
    rowHeight: medium

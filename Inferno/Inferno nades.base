views:
  - type: cards
    name: Table
    filters:
      and:
        - file.hasProperty("Nade")
        - Map.contains("Inferno")
    groupBy:
      property: Nade
      direction: DESC
    order:
      - file.name
      - Link
      - Nade
      - Side
      - Type
      - Throw Type
      - Date Added
      - Creator
      - Have Tried
    rowHeight: medium
    image: note.image
    imageAspectRatio: 1.15
    cardSize: 310

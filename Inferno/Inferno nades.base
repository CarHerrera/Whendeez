filters:
  and:
    - Map == link("Inferno")
    - "!Nade.isEmpty()"
views:
  - type: cards
    name: Table
    filters:
      and:
        - Side == "T"
    filterBy:
      property: Lands
    groupBy:
      property: Nade
      direction: DESC
    order:
      - file.name
      - Link
      - Nade
      - Side
      - Type
      - Throw Type
      - Date Added
      - Creator
      - Have Tried
      - Usage
      - Used by
    sort:
      - property: Usage
        direction: ASC
    rowHeight: medium
    image: note.image
    imageAspectRatio: 1.15
    cardSize: 310
    imageFit: contain
  - type: cards
    name: Smokes
    filters:
      and:
        - Nade.contains("Smoke")
    filterBy:
      property: Lands
    groupBy:
      property: Lands
      direction: ASC
    order:
      - file.name
      - Creator
      - Date Added
      - Have Tried
      - Link
      - Side
      - Usage
      - Lands
    sort:
      - property: Side
        direction: ASC
    image: note.image
    imageFit: contain
  - type: cards
    name: Flashes
    filters:
      and:
        - Nade.containsAny("Flash", "Flashbang")
    filterBy:
      property: Lands
    groupBy:
      property: Usage
      direction: ASC
    order:
      - file.name
      - Creator
      - Date Added
      - Have Tried
      - Link
      - Side
      - Usage
    image: note.image
  - type: cards
    name: Fire
    filters:
      and:
        - Nade.containsAny("Molotov")
    filterBy:
      property: Lands
    groupBy:
      property: Usage
      direction: ASC
    order:
      - file.name
      - Creator
      - Date Added
      - Have Tried
      - Link
      - Side
      - Usage
    image: note.image
  - type: cards
    name: HE and MISC
    filters:
      and:
        - Nade.containsAny("HE")
    filterBy:
      property: Lands
    groupBy:
      property: Usage
      direction: ASC
    order:
      - file.name
      - Creator
      - Date Added
      - Have Tried
      - Link
      - Side
      - Usage
    image: note.image
  - type: table
    name: View
    filterBy:
      property: Lands
    order:
      - file.name
      - Lands
      - Nade
      - Side
      - Usage
      - Used by
    sort: []

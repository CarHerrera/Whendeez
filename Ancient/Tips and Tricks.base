filters:
  and:
    - file.inFolder("Ancient/Tips & Tricks")
views:
  - type: cards
    name: All
    filterBy:
      property: Lands
    groupBy:
      property: Type
      direction: ASC
    order:
      - file.name
      - Date Added
      - Link
      - Map
      - Nade
      - Creator
      - file.backlinks
    sort:
      - property: file.name
        direction: ASC
    image: note.image

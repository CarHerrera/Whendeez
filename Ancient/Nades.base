views:
  - type: cards
    name: Card
    filters:
      and:
        - file.hasProperty("Nade")
        - Map == "Ancient"
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - Link
      - Nade
      - Side
    sort:
      - property: image
        direction: ASC
    image: note.image
    imageAspectRatio: 1.15
    cardSize: 290

filters:
  or:
    - file.inFolder("Cache/Nades")
    - and:
        - file.hasProperty("Nade")
        - Map == link("Cache/Cache")
views:
  - type: table
    name: Table
    filterBy:
      property: Lands
    order:
      - file.name
      - Side
      - Lands
    sort:
      - property: Side
        direction: ASC
      - property: Nade
        direction: ASC
  - type: cards
    name: View
    filterBy:
      property: Lands
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - Date Added
      - Creator
      - Map
      - Link
      - Nade
      - Side
      - Throw Type
      - Used by
      - Usage
    sort:
      - property: Side
        direction: ASC
    image: note.image
    imageFit: contain

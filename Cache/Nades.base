filters:
  and:
    - file.inFolder("Cache/Grenades")
views:
  - type: table
    name: Table
  - type: cards
    name: View
    groupBy:
      property: Nade
      direction: ASC
    order:
      - file.name
      - Date Added
      - Creator
      - Map
      - Link
      - Nade
      - Side
    sort:
      - property: Side
        direction: ASC
    image: note.image
